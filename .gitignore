# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Aset sumber — tidak dibutuhkan untuk menjalankan situs.
# Yang benar-benar dipakai sudah diekspor ke public/ (logo, kartu, audio, foto).
# File-file ini tetap ada di disk, hanya tidak ikut masuk repo.
/Foto Profil/
/Companies Logo/
/Game Platform/
/*.wav
/*.pdf
